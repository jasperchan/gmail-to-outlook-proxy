# copy to deploy/.env on the server (gitignored)

# certificate for the SMTP host (issued with certbot's Cloudflare DNS plugin)
CERT_DOMAIN=smtp.example.com
CERT_EMAIL=you@example.com
# Cloudflare API token ini, see https://certbot-dns-cloudflare.readthedocs.io/
CLOUDFLARE_CREDENTIALS=/home/ec2-user/.cloudflare/sendas.ini

# where daily sqlite backups go (leave empty to skip)
BACKUP_S3_URI=s3://my-bucket/db

# user that should own ./certificates after renewal
OWNER=ec2-user
