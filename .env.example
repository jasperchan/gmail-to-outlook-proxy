# JSON array of app registrations, on a SINGLE line (.env values can't span lines).
# id = Application (client) ID, secret = the client secret's Value (not its Secret ID).
# Optional per app:
#   "name":   alias for /auth?app=<name>
#   "tenant": "consumers" (personal accounts, default), "organizations", "common", or a tenant id/domain
# e.g. [{"id":"...","secret":"..."},{"id":"...","secret":"...","name":"work","tenant":"<tenant-id>"}]
MICROSOFT_APPS=
MICROSOFT_APPS_DEFAULT_ID=

SESSION_SECRET=
SESSION_COOKIE=sendas

SQLITE_PATH=data/db.sqlite

# SMTP server hostname (must match the certificate); key/cert paths as the app sees
# them, e.g. certificates/live/<SMTP_HOST>/privkey.pem and .../fullchain.pem
SMTP_HOST=
SMTP_KEY_FILE=
SMTP_CERT_FILE=

# optional

# host port for docker compose
# WEB_PORT=3000

# host directory mounted at certificates/ in docker compose (default ./certificates)
# CERTIFICATES_DIR=/etc/letsencrypt

# SMTP listen port (local dev) / host port (docker compose)
# SMTP_PORT=587

# log messages instead of sending through Microsoft Graph
# SMTP_DRY_RUN=1

# how long to wait for more copies of a message before sending (Gmail sends one per recipient)
# SMTP_MERGE_WINDOW_MS=5000
# SMTP_MERGE_MAX_MS=60000

# custom login/send hooks: create a gitignored hooks.local.js, see lib/hooks.ts
